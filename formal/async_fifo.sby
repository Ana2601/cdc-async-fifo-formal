# Multi-clock formal check of the async FIFO.
#   bmc   - every assertion holds on every trace of 24 global steps from reset,
#           with arbitrary interleaving of wclk/rclk edges (>= two full pointer wraps)
#   prove - unbounded proof by k-induction (depth 20): the properties hold in
#           every reachable state, for any phase and any clock ratio up to 3:1
#   cover - witnesses for "FIFO full" and "watched word read back while full"

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 20
cover: mode cover
cover: depth 30
multiclock on

[engines]
smtbmc z3

[script]
read_verilog -formal -sv async_fifo.sv
read_verilog -formal -sv async_fifo_formal.sv
prep -top async_fifo_formal

[files]
../rtl/async_fifo.sv
async_fifo_formal.sv
